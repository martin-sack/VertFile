{
  "name": "file-converter-pro",
  "version": "1.0.3",
  "description": "Professional desktop file converter with support for PDF, Office, images, and more",
  "main": "dist/main/main.js",
  "author": "Martin Sack <lennyymartin773@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:main && npm run build:preload && wait-on http://localhost:5174 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5174 electron .",
    "dev:main": "npm run build:main && npm run build:preload && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "icons": "bash scripts/generate-app-icons.sh",
    "package": "npm run build && electron-builder --config electron-builder.json",
    "package:all": "npm run build && electron-builder --mac --win --linux --config electron-builder.json",
    "package:win": "npm run build && electron-builder --win --config electron-builder.json",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.json",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.json"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "browser-image-compression": "^2.0.2",
    "jspdf": "^2.5.1",
    "papaparse": "^5.4.1",
    "jimp": "^0.22.12"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/papaparse": "^5.3.14",
    "@types/path-browserify": "1.0.3",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "path-browserify": "^1.0.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "9.0.3"
  }
}
